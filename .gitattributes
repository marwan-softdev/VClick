# Keep the AppImage build tooling out of the source archive (GitHub's
# "Download ZIP" button and the /archive/refs/heads/<branch>.zip URL): the
# terminal-install path (install.sh / install.bat) and the AppImage are
# meant to be two separate distribution channels, not bundled together.
# The files stay tracked in git (needed for CI, which clones rather than
# archiving) -- this only affects what a generated archive contains.
/packaging/** export-ignore
/.github/** export-ignore
