# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtualenv
.venv/
venv/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local config the app writes at runtime
config.json

# Packaging build outputs (produced by build-appimage.sh)
packaging/appimage/*.AppImage
packaging/appimage/AppDir/
packaging/appimage/base.AppImage

# Packaging build outputs (produced by build-source-zips.sh)
packaging/source-packages/*.zip

# Packaging build outputs (produced by build-exe.bat / PyInstaller)
packaging/windows-exe/dist/
packaging/windows-exe/build/
packaging/windows-exe/check-dist/
packaging/windows-exe/*.spec
